				deathParticlePosInfo(deathParticle, VEL_X) = deathParticlePosInfo(deathParticle, VEL_X) * 0.9 + cos(deg2rad(deathParticlePosInfo(deathParticle, ROT))) * 0.5 + cos(deg2rad(deathParticleRot + 180)) * reused_1
				deathParticlePosInfo(deathParticle, VEL_Y) = deathParticlePosInfo(deathParticle, VEL_Y) * 0.9 + sin(deg2rad(deathParticlePosInfo(deathParticle, ROT))) * 0.5 + sin(deg2rad(deathParticleRot + 180)) * reused_1
				deathParticlePosInfo(deathParticle, POS_X) += deathParticlePosInfo(deathParticle, VEL_X)
				deathParticlePosInfo(deathParticle, POS_Y) += deathParticlePosInfo(deathParticle, VEL_Y)
			}
			if ( deathParticleSize(deathParticle) == 1 ) {
				deathParticlePosInfo(deathParticle, VEL_X) = deathParticlePosInfo(deathParticle, VEL_X) * 0.9
				deathParticlePosInfo(deathParticle, VEL_Y) = deathParticlePosInfo(deathParticle, VEL_Y) * 0.9
				deathParticlePosInfo(deathParticle, POS_X) += deathParticlePosInfo(deathParticle, VEL_X) - playerAccelerationX
				deathParticlePosInfo(deathParticle, POS_Y) += deathParticlePosInfo(deathParticle, VEL_Y) - playerAccelerationY
			}
			if ( deathParticleSize(deathParticle) == 2 ) {
				deathParticlePosInfo(deathParticle, VEL_X) = deathParticlePosInfo(deathParticle, VEL_X) * 0.8
				deathParticlePosInfo(deathParticle, VEL_Y) = deathParticlePosInfo(deathParticle, VEL_Y) * 0.8
				deathParticlePosInfo(deathParticle, POS_X) += deathParticlePosInfo(deathParticle, VEL_X) - playerAccelerationX
				deathParticlePosInfo(deathParticle, POS_Y) += deathParticlePosInfo(deathParticle, VEL_Y) - playerAccelerationY
				if ( deathParticleType(deathParticle) >= 1 ) {
					deathParticleType(deathParticle) -= 1
				}
			}
			if ( deathParticleType(deathParticle) >= 1 ) {
				deathParticleType(deathParticle) -= 1
			}
		next
	}
	return
*getAvailablePlayerBulletSlot
	newProjectile = -1
	for slot,0,maxProjectiles,1
		if ( playerBulletType(slot) == 0 ) {
			newProjectile = slot
			return
		}
	next
	return
*getAvailableEnemyProjectileSlot
	newProjectile = -1
	for slot,0,maxProjectiles,1
		if ( enemyProjectileType(slot) == 0 ) {
			newProjectile = slot
			return
		}
	next
	return
*getAvailableDeathParticleSlot
	newDeathP = -1
	for slot,0,maxDeathParticles,1
		if ( deathParticleType(slot) == 0 ) {
			newDeathP = slot
			return
		}
	next
	return
*getAvailableEnemySlot
	newEnemy = -1
	for slot,0,maxEnemies,1
		if ( enemyType(slot) == 0 ) {
			newEnemy = slot
			return
		}
	next
	return
*checkKeys
	if ( ginfo_act == 0 ) {
		getkey keyInfo(KEY_LEFT, isPressed), 37
		getkey keyInfo(KEY_UP, isPressed), 38
		getkey keyInfo(KEY_RIGHT, isPressed), 39
		getkey keyInfo(KEY_DOWN, isPressed), 40
		getkey keyInfo(KEY_Z, isPressed), 90
		getkey keyInfo(KEY_X, isPressed), 88
		getkey keyInfo(KEY_S, isPressed), 83
		getkey keyInfo(KEY_C, isPressed), 67
		getkey keyInfo(KEY_R, isPressed), 82
		getkey keyInfo(KEY_T, isPressed), 84
		getkey keyInfo(KEY_O, isPressed), 79
		getkey keyInfo(KEY_Q, isPressed), 81
		getkey keyInfo(KEY_ESC, isPressed), 27
		for key,0,20,1
			if ( keyInfo(key, isPressed) == 1 ) {
				keyInfo(key, pressedTime) += 1
			}
			else {
				keyInfo(key, pressedTime) = 0
			}
		next
		if ( keyInfo(KEY_ESC, isPressed) == 1 ) {
			goto *exit
		}
	}
	else {
		dim keyInfo, 20, 2
	}
	return
*playSfx
	repeat maxSfxFileID
		if ( sfxInfo(cnt, isPlaying) == 1 ) {
			ds_play maxSfxFileID * sfxInfo(cnt, 1) + cnt
			sfxInfo(cnt, isPlaying) = 0
			sfxInfo(cnt, 1) = (sfxInfo(cnt, 1) + 1) \ unk_1  // rakubloat: this also appears in ghost mayoker and seems to be unused as well
		}
	loop
	return
*loopRoundMusic
	if ( shouldRestartRoundMusic == 1 ) {
		shouldRestartRoundMusic = 0
		ds_stop soundBufferBaseID + var_204
		ds_loop soundBufferBaseID + loopingRoundMusicID
		var_204 = loopingRoundMusicID
	}
	return
*updateVolume
	repeat maxSfxFileID * unk_1
		ds_vol cnt, sfxVolume
	loop
	repeat 50 + 10
		ds_vol cnt + soundBufferBaseID, musicVolume
	loop
	return
*changeScreenSize
	screen 0, (screenSize + 1) * 320, (screenSize + 1) * 240, screen_fixedsize, ginfo_dispx / 2 - 3 - (screenSize + 1) * 160, ginfo_dispy / 2 - 22 - (screenSize + 1) * 120
	return
*resetVariables
	playerWalkAnimFrame = 0
	damage = 0
	shieldSfxLoopTimer = 0
	shieldActive = 0
	shieldCountdown = 0
	slot = 0
	newProjectile = 0
	backgroundScrollX = 0
	backgroundScrollY = 0
	deathParticle = 0
	unused_3 = 0
	roundTimer = 0
	gameOverTimer = 0
	reused_1 = 0
	unused_4 = 0
	reused_2 = 0
	deathParticlePosYCenter = 0
	var_111 = 0
	currentScoreCounterDigit = 0
	scoreCounterDigitPlace = 0
	randomTitleScreenImage = 0
	scoreCounterDigitAnimStep = 0
	scoreCounterDigitFade = 0

	reused_3 = 0
	isScoreCounterDigitFullyVisible = 0

	enemyProjectileRot = 0
	deathParticleRot = 0
	enemyDistanceX = 0
	enemyDistanceY = 0
	index = 0
	whiteBulletCountdown = 0
	shouldRestartRoundMusic = 0
	loopingRoundMusicTimer = 0
	loopingRoundMusicID = 0
	var_204 = 0
	enemySpawnPositionA = 0
	enemySpawnPositionB = 0
	tripleBulletCountdown = 0
	nextSectionTextFade = 0
	section = 0
	sectionTimer = 0
	enemySpawnPattern = 0
	playerAccelerationX = 0
	playerAccelerationY = 0
	nextSectionBackgroundTimer = 0
	playerDamageBoostCountdown = 0
	playerAngle = 0
	var_205 = 0
	currentEnemyAnimTimer = 0
	var_182 = 0
	var_183 = 0
	playerAbsoluteX = 0
	playerAbsoluteY = 0
	enemiesOnField = 0
	var_184 = 0
	var_201 = 0
	var_206 = 0
	nullptr = 0 // getstr is only used here to get string length, so this dummy variable is used as the necessary first argument
	enemy = 0
	enemyDistanceToPlayerX = 0
	enemyDistanceToPlayerY = 0
	currentTime = 0
	initialTime = 0
	var_168 = 0
	scoreMultiplier = 0
	comboHealth = 0
	scoreMultiplierWhenComboEnded = 0
	postComboEndedTimer = 0
	scoreNumberInterpolation = 0
	sectionFadeTimer = 0
	return
*exit
	saveData = 0
	saveData = ""
	repeat 10
		saveData += str(scores(cnt)) + "\n"
	loop
	bsave "data\\savedata\\0", saveData
	end
